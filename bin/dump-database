#!/bin/bash


if [ -f .env ]; then
    set -o allexport
    source .env
    set +o allexport
fi

g_database=
g_schemas=()
g_host=$(dnsdomainname -A)
g_user=
g_port=9023
g_compress=YES
g_filename=
g_bare=YES
g_timestamp=$(date +'%Y%m%d_%H%M%S')

if [ -f ~/vault/.default.sead.server ]; then
    g_host=`cat ~/vault/.default.sead.server`
fi

if [ -f ~/vault/.default.sead.username ]; then
    g_user=`cat  ~/vault/.default.sead.username`
fi

function usage()
{
    local error_message=$1
    if [ "$error_message" != "" ]; then
        echo "[$g_timestamp]: $error_message" >&2
    fi
    echo "usage: dump-database [OPTIONS...] DBNAME"
    echo "Creates a dump of the database."
    echo "Options:"
    echo "   --schema SCHEMA           schema name (can be specified multiple times)"
    echo "   --host HOSTNAME           host name"
    echo "   --user USERNAME           user name"
    echo "   --port PORT               host port "
    echo "   --compress                compress dump with gzip"
    echo "   --output FILENAME         output file name"
    echo "   --bare                    bare dump (no tablespaces, no owner, no privileges, no comments)"
    exit 64
}

POSITIONAL=()
while [[ $# -gt 0 ]]
do
    key="$1"
    case $key in
        --schema|-s)
            if [[ $# -lt 2 || "$2" == --* ]]; then
                usage "--schema requires a schema name"
            fi
            g_schemas+=("$2"); shift 2;
        ;;
        --compress|-c)
            g_compress="YES"; shift;
        ;;
        --no-compress)
            g_compress="NO"; shift;
        ;;
        --port|-p)
            g_port="$2"; shift 2;
        ;;
        --user|-U)
            g_user="$2"; shift 2;
        ;;
        --host|-h)
            g_host="$2"; shift 2;
        ;;
        --output|-o)
            g_filename="$2"; shift 2;
        ;;
        --bare|-b)
            g_bare="YES"; shift
        ;;
        --no-bare)
            g_bare="NO"; shift
        ;;
        --help|-\?)
            usage
        ;;
        *)
            POSITIONAL+=("$1")
            shift
        ;;
    esac
done

set -- "${POSITIONAL[@]}"

g_database=$1


if [ "$g_database" == "" ]; then
    usage
fi


g_opts=(--format=p --create --clean)

if [ "$g_bare" == "YES" ]; then
    g_opts+=(--no-tablespaces --no-owner --no-privileges --no-comments)
else
    g_opts+=(--if-exists)
fi

if [ "$g_filename" == "" ]; then
    if [ "${#g_schemas[@]}" -gt 0 ]; then
        schema_filename=$(IFS=_; printf '%s' "${g_schemas[*]}")
        g_filename=${g_database}_${schema_filename}_${g_timestamp}.sql
    else
        g_filename=${g_database}_${g_timestamp}.sql
    fi    
fi

for schema in "${g_schemas[@]}"; do
    g_opts+=("--schema=$schema")
done

g_command=(pg_dump --file="$g_filename" "${g_opts[@]}" --dbname="$g_database" --username="$g_user" --host="$g_host" --port="$g_port" --blobs)
printf '%q ' "${g_command[@]}"
printf '\n'

"${g_command[@]}"

if [ "$g_compress" == "YES" ]; then
    gzip "$g_filename"
fi
