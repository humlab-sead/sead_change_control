#!/bin/bash

SHELL=/bin/bash

set -e

function usage() {
    echo "Usage: $0 <bundle.zip|bundle-dir> [--issue-id <issue-id>] [--no-issues] [--dry-run]"
    echo ""
    echo "Add a change request generated by an SDF import (json_api_server POST /sdf/change-request)"
    echo "to the sdf project, and file its GitHub issues."
    echo ""
    echo "  <bundle.zip|bundle-dir>    The bundle as downloaded, or unpacked."
    echo "  --issue-id <issue-id>      Link the change request to this existing issue instead of"
    echo "                             creating one from the bundle's change.json."
    echo "  --no-issues                Create no issues at all: neither the change request's nor"
    echo "                             one per proposal."
    echo "  --dry-run                  Show what would be done, and change nothing."
    echo "  --help|-h                  Show this help."
    echo ""
    echo "The change request goes through bin/add-change-request, so the plan entry, the file"
    echo "layout and the issue link follow the usual workflow. Its deploy, revert and verify"
    echo "scripts are then replaced by the bundle's. Each proposals/*.md becomes an issue of its"
    echo "own, for a data manager to decide on; SDF never applies a proposal itself."
}

bundle=
issue_id=
no_issues=NO
dry_run=NO
script_dir=$(cd "$( dirname "${BASH_SOURCE[0]}")" && pwd )
repo_root=$(cd "$script_dir/.." && pwd)

while [[ $# -gt 0 ]]
do
    key="$1"

    case $key in
        --issue-id)
            issue_id="$2";
            shift 2;
        ;;
        --no-issues)
            no_issues=YES;
            shift;
        ;;
        --dry-run)
            dry_run=YES;
            shift;
        ;;
        --help|-h)
            usage;
            exit 0;
        ;;
        --*)
            echo "error: invalid option $1"
            usage
            exit 64
        ;;
        *)
            if [ -n "$bundle" ]; then
                echo "error: only one bundle can be added at a time"
                exit 64
            fi
            bundle="$1";
            shift
        ;;
    esac
done

if [ -z "$bundle" ]; then
    usage
    exit 64
fi

for tool in jq unzip; do
    if ! command -v $tool > /dev/null; then
        echo "error: $tool is required"
        exit 64
    fi
done

cd "$repo_root"

work_dir=
if [ -d "$bundle" ]; then
    bundle_dir=$(cd "$bundle" && pwd)
elif [ -f "$bundle" ]; then
    work_dir=$(mktemp -d)
    trap 'rm -rf "$work_dir"' EXIT
    unzip -q "$bundle" -d "$work_dir"
    bundle_dir="$work_dir"
else
    echo "error: $bundle is neither a file nor a directory"
    exit 64
fi

# The zip holds a single <name>/ folder; accept the folder itself too.
change_json=$(find "$bundle_dir" -maxdepth 2 -name change.json | head -n 1)
if [ -z "$change_json" ]; then
    echo "error: no change.json in $bundle; is this an SDF change-request bundle?"
    exit 64
fi
bundle_dir=$(dirname "$change_json")

change=$(jq -r '.name // empty' "$change_json")
project=$(jq -r '.project // empty' "$change_json")
note=$(jq -r '.plan_note // empty' "$change_json")
sdf_version=$(jq -r '.sdf_version // empty' "$change_json")

echo "info: SDF bundle $(basename "$bundle_dir") ($sdf_version)"

if [ -n "$change" ]; then

    if [ "$project" != "sdf" ]; then
        echo "error: change.json names project '$project'; SDF change requests belong in sdf"
        exit 64
    fi
    if [ ! -f "$project/sqitch.plan" ]; then
        echo "error: project $project does not exist"
        exit 64
    fi
    if grep -q -e "^${change} " "$project/sqitch.plan"; then
        echo "error: $change is already in $project/sqitch.plan"
        exit 64
    fi
    for type in deploy revert verify; do
        if [ ! -f "$bundle_dir/$type/$change.sql" ]; then
            echo "error: the bundle has no $type/$change.sql"
            exit 64
        fi
    done

    if [ "$dry_run" == "YES" ]; then
        echo "dry-run: would add $project:$change - $note"
        if [ -n "$issue_id" ]; then
            echo "dry-run: would link it to issue $issue_id"
        elif [ "$no_issues" == "NO" ]; then
            echo "dry-run: would create issue \"$(jq -r '.issue.title' "$change_json")\" [$(jq -r '.issue.labels | join(",")' "$change_json")]"
        fi
    else
        if [ -z "$issue_id" ] && [ "$no_issues" == "NO" ]; then
            label_args=()
            for label in $(jq -r '.issue.labels[]' "$change_json"); do
                label_args+=(--label "$label")
            done
            issue_url=$(gh issue create \
                --title "$(jq -r '.issue.title' "$change_json")" \
                --body "$(jq -r '.issue.body' "$change_json")" \
                "${label_args[@]}" \
                --assignee @me)
            issue_id=$(basename "$issue_url")
            echo "info: new issue ${issue_id} created ($issue_url)"
        fi

        if [ -n "$issue_id" ]; then
            "$script_dir/add-change-request" --change "$change" --project "$project" --note "$note" --issue-id "$issue_id"
        else
            sqitch add "$change" --set today="$(date +%Y-%m-%d)" -C "$project" -n "$note"
        fi

        for type in deploy revert verify; do
            cp "$bundle_dir/$type/$change.sql" "$project/$type/$change.sql"
        done
        "$script_dir/update-cr-header" --change "$change" --project "$project"

        echo "info: added $project:$change"
    fi
else
    echo "info: the bundle holds no data changes, only proposals"
fi

proposals=$(find "$bundle_dir/proposals" -name '*.md' 2>/dev/null | sort)
if [ -n "$proposals" ] && [ "$no_issues" == "NO" ]; then
    for proposal in $proposals; do
        title=$(sed -n '1s/^# //p' "$proposal")
        label=$(sed -n 's/^Labels: //p' "$proposal" | head -n 1)
        body=$(sed '1,/^Labels: /d' "$proposal")
        if [ "$dry_run" == "YES" ]; then
            echo "dry-run: would create issue \"$title\" [$label]"
            continue
        fi
        if ! url=$(gh issue create --title "$title" --body "$body" --label "$label" 2> /dev/null); then
            echo "warning: could not label \"$title\" as $label; creating it without the label"
            url=$(gh issue create --title "$title" --body "$body")
        fi
        echo "info: proposal filed: $url"
    done
elif [ -n "$proposals" ]; then
    echo "info: $(echo "$proposals" | wc -l) proposal(s) not filed (--no-issues)"
fi

if [ -n "$change" ] && [ "$dry_run" == "NO" ]; then
    echo ""
    echo "Next: review $project/deploy/$change.sql, then deploy it to staging as usual."
    echo "Entries left out (conflicts, rows waiting on proposals) are listed in the bundle's report.json."
fi
