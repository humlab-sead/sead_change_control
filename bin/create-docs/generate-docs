#!/bin/bash
set -euo pipefail

# Generate a SchemaSpy site for the requested PostgreSQL database and schema:
# resolve connection settings and validate the empty output folder, extract
# SchemaSpy's layout from the Podman image and apply repository templates,
# run SchemaSpy, then normalize its generated columns.html. Temporary files
# and containers are cleaned up on exit; publishing the site is a separate step.

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd "$script_dir/../.." && pwd)"

# --- Define command-line defaults and help text ---
database=""
schema=""
target_folder=""
host="${PGHOST:-host.containers.internal}"
port="${PGPORT:-9023}"
user="${PGUSER:-}"

usage() {
    cat <<EOF
Usage: $0 DATABASE SCHEMA --target-folder FOLDER [OPTIONS]

Generate SchemaSpy documentation from comments in a PostgreSQL database.
The target folder must be empty or not yet exist.

Options:
  --host HOST             PostgreSQL host (default: PGHOST or host.containers.internal)
  --port PORT             PostgreSQL port (default: PGPORT or 9023)
  --user USER             PostgreSQL user (default: PGUSER)
  --target-folder FOLDER  Empty folder for generated site files (required)
  --help                  Show this help
EOF
}

escape_properties_value() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value// /\\ }"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\f'/\\f}"
    printf '%s' "$value"
}

read_pgpass_password() {
    local pgpass_file="$1"
    local requested_host="$2"
    local requested_port="$3"
    local requested_database="$4"
    local requested_user="$5"
    local line character field escaped index
    local -a fields=()

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == \#* ]] && continue
        fields=()
        field=""
        escaped=0
        for ((index = 0; index < ${#line}; index++)); do
            character="${line:index:1}"
            if ((escaped)); then
                field+="$character"
                escaped=0
            elif [[ "$character" == "\\" ]]; then
                escaped=1
            elif [[ "$character" == ":" ]]; then
                fields+=("$field")
                field=""
            else
                field+="$character"
            fi
        done
        if ((escaped)); then
            field+="\\"
        fi
        fields+=("$field")
        if ((${#fields[@]} != 5)); then
            continue
        fi

        if [[ ( "${fields[0]}" == '*' || "${fields[0]}" == "$requested_host" ) &&
            ( "${fields[1]}" == '*' || "${fields[1]}" == "$requested_port" ) &&
            ( "${fields[2]}" == '*' || "${fields[2]}" == "$requested_database" ) &&
            ( "${fields[3]}" == '*' || "${fields[3]}" == "$requested_user" ) ]]; then
            printf '%s' "${fields[4]}"
            return 0
        fi
    done < "$pgpass_file"

    return 1
}

# --- Parse arguments and validate the requested database, schema, and target ---
positionals=()
while (($#)); do
    case "$1" in
        --host|--port|--user|--target-folder)
            if (($# < 2)) || [[ -z "$2" ]]; then
                echo "error: $1 requires a value" >&2
                usage >&2
                exit 64
            fi
            case "$1" in
                --host) host="$2" ;;
                --port) port="$2" ;;
                --user) user="$2" ;;
                --target-folder) target_folder="$2" ;;
            esac
            shift 2
            ;;
        --help)
            usage
            exit 0
            ;;
        --)
            shift
            positionals+=("$@")
            break
            ;;
        -*)
            echo "error: unknown option $1" >&2
            usage >&2
            exit 64
            ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

if ((${#positionals[@]} != 2)); then
    usage >&2
    exit 64
fi

database="${positionals[0]}"
schema="${positionals[1]}"
if [[ -z "$target_folder" ]]; then
    echo "error: --target-folder is required" >&2
    usage >&2
    exit 64
fi

# --- Resolve database connection settings from .env and the environment ---
if [[ -f "$repository_root/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$repository_root/.env"
    set +a
fi

host="${host:-${PGHOST:-}}"
port="${PGPORT:-$port}"
user="${user:-${PGUSER:-}}"
database_password="${PGPASSWORD:-}"
unset PGPASSWORD
pgpass_file="${PGPASSFILE:-$HOME/.pgpass}"
if [[ -z "$database_password" && ( -e "$pgpass_file" || -n "${PGPASSFILE:-}" ) ]]; then
    if [[ ! -f "$pgpass_file" || ! -r "$pgpass_file" ]]; then
        echo "error: PGPASSFILE is not a readable file: $pgpass_file" >&2
        exit 64
    fi
    if ! pgpass_mode="$(stat -c '%a' -- "$pgpass_file")"; then
        echo "error: could not check permissions on PGPASSFILE: $pgpass_file" >&2
        exit 1
    fi
    if (( (8#$pgpass_mode & 077) != 0 )); then
        echo "error: PGPASSFILE must not be accessible by group or others: $pgpass_file" >&2
        exit 64
    fi
    if pgpass_password="$(read_pgpass_password "$pgpass_file" "${host:-localhost}" "$port" "$database" "$user")"; then
        database_password="$pgpass_password"
    elif [[ -n "${PGPASSFILE:-}" ]]; then
        echo "error: PGPASSFILE has no entry matching the selected connection" >&2
        exit 64
    fi
fi
if [[ "$database_password" == *$'\n'* ]]; then
    echo "error: database password must not contain a newline" >&2
    exit 64
fi

# --- Create the output directory and require it to be empty ---
mkdir -p "$target_folder"
target_folder="$(cd "$target_folder" && pwd -P)"
if [[ -n "$(find "$target_folder" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
    echo "error: target folder must be empty: $target_folder" >&2
    exit 64
fi

# --- Select the SchemaSpy image and check required local tools ---
SCHEMASPY_IMAGE="${SCHEMASPY_IMAGE:-docker.io/schemaspy/schemaspy:latest}"
for command_name in podman jar; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "error: $command_name is required to generate documentation" >&2
        exit 1
    fi
done

# --- Create a temporary workspace and register cleanup ---
temporary_folder="$(mktemp -d)"
container_id=""
cleanup() {
    if [[ -n "$container_id" ]]; then
        podman rm -f "$container_id" >/dev/null 2>&1 || true
    fi
    rm -rf "$temporary_folder"
}
trap cleanup EXIT

# --- Extract SchemaSpy's built-in layout from its Podman image ---
container_id="$(podman create "$SCHEMASPY_IMAGE")"
podman cp "$container_id:/usr/local/lib/schemaspy/schemaspy-app.jar" "$temporary_folder/schemaspy-app.jar"
podman rm "$container_id" >/dev/null
container_id=""

(
    cd "$temporary_folder"
    jar xf schemaspy-app.jar BOOT-INF/classes/layout
)
layout_folder="$temporary_folder/BOOT-INF/classes/layout"
if [[ ! -d "$layout_folder" ]]; then
    echo "error: SchemaSpy image did not contain its layout files" >&2
    exit 1
fi
mv "$layout_folder" "$target_folder/layout"

# --- Install the PostgreSQL configuration and overridden HTML templates ---
cp "$script_dir/resources/pgsql17.properties" "$target_folder/pgsql17.properties"
cp "$script_dir/resources/main.html" "$script_dir/resources/column.html" "$target_folder/layout/"
mkdir -p "$target_folder/layout/tables"
cp "$script_dir/resources/tables/table.html" "$target_folder/layout/tables/"

# --- Build SchemaSpy connection options and mount credentials when available ---
connection_options=(-port "$port" -db "$database" -s "$schema")
if [[ -n "$host" ]]; then
    connection_options+=(-host "$host")
fi
if [[ -n "$user" ]]; then
    connection_options+=(-u "$user")
fi
podman_options=()
    if [[ -n "$database_password" ]]; then
    password_file="$temporary_folder/schemaspy.properties"
        printf 'schemaspy.p=%s\n' "$(escape_properties_value "$database_password")" > "$password_file"
    chmod 600 "$password_file"
    podman_options+=(--mount "type=bind,src=$password_file,dst=/tmp/schemaspy.properties,readonly")
    connection_options+=(-configFile /tmp/schemaspy.properties)
fi

# --- Run SchemaSpy with the selected database and prepared layout ---
# Preserve the host UID/GID mapping for the private password mount and output files.
podman run --rm \
    --userns=keep-id \
    --volume "$target_folder:/output" \
    --user "$(id -u):$(id -g)" \
    "${podman_options[@]}" \
    "$SCHEMASPY_IMAGE" \
    -t /output/pgsql17.properties \
    "${connection_options[@]}" \
    -template /output/layout

# --- Verify and normalize the generated column metadata ---
columns_file="$target_folder/columns.html"
if [[ ! -f "$columns_file" ]]; then
    echo "error: SchemaSpy did not generate $columns_file" >&2
    exit 1
fi
sed -Ez 's|"defaultValue":\s*"\n([^"]+)",|"defaultValue": "",|g' "$columns_file" \
    > "$columns_file.tmp"
mv "$columns_file.tmp" "$columns_file"

echo "SchemaSpy documentation generated in $target_folder"
