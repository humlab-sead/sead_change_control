#!/bin/bash

export PGCLIENTENCODING=UTF8

dothostfile=~/vault/.default.sead.server
dotuserfile=~/vault/.default.sead.username

g_database=sead_staging
g_schema=public
g_host=$(dnsdomainname -A)
g_port=5433
g_username=

# if [[ -f "$dothostfile" ]]; then
#     g_host=`cat $dothostfile`
# fi
if [[ -f "$dotuserfile" ]]; then
    g_username=`cat $dotuserfile`
fi

usage_message=$(cat <<EOF
usage: xyz OPTIONS... DATABASE

    --host SERVERNAME               Target server (${g_host})
    --user USERNAME                 User on target server (${g_username})
    --port PORT                     Port on target server (${g_port})
    --schema SCHEMANAME             Schema name (${g_schema})

EOF
)

POSITIONAL=()
while [[ $# -gt 0 ]]
do
    key="$1"

    case $key in
        --host)
            g_host="$2"; shift; shift
        ;;
        --user|-U)
            g_username="$2"; shift; shift
        ;;
        --schema|-s)
            g_schema="$2"; shift; shift
        ;;
        --port|-p)
            g_port="$2"; shift; shift
        ;;
        *)
            POSITIONAL+=("$1") # save it in an array for later
            shift
        ;;
    esac
done

g_database="${POSITIONAL[0]}"

if [ "$g_database" == "" ]; then
    echo "Database name is required." >&2
    usage
fi

# tables_sql="select string_agg(tablename, ' ') from pg_tables where schemaname = 'public'"

# public_tables=`psql --host=$g_host --username=$g_username --no-password --dbname=$g_database -tAc "$tables_sql"`

# for table in $public_tables
# do
    pg_dump --schema-only \
        --no-owner \
        --no-privileges \
        --format=p \
        --username=$g_username \
        --dbname=$g_database \
        --schema=$g_schema \
        --host=$g_host \
        --port=$g_port \
        --no-security-labels \
        --no-tablespaces
        
        #  \ --file=a.sql

        # --table=$table \
# done

