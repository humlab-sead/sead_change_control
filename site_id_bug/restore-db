#!/usr/bin/env bash

set -euo pipefail

# PostgreSQL CLI options.
# Example for a remote server:
# PG_OPTS="-h db.example.org -p 5432 -U postgres"
PG_OPTS="-h humlabseadserv.srv.its.umu.se -p 5433 -U humlab_admin"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <dump.sql.gz>" >&2
    exit 1
fi

DUMP_FILE="$1"

if [[ ! -f "$DUMP_FILE" ]]; then
    echo "Error: File not found: $DUMP_FILE" >&2
    exit 1
fi

# abc.sql.gz -> abc
BASENAME="$(basename "$DUMP_FILE")"
DB_NAME="${BASENAME%.sql.gz}"

if [[ "$DB_NAME" == "$BASENAME" ]]; then
    echo "Error: Expected a file ending in .sql.gz" >&2
    exit 1
fi

echo "Creating database: $DB_NAME"

createdb $PG_OPTS "$DB_NAME"

echo "Restoring: $DUMP_FILE -> $DB_NAME"

gzip -dc "$DUMP_FILE" | \
    psql $PG_OPTS \
        --dbname="$DB_NAME" \
        --set=ON_ERROR_STOP=1

echo "Restore completed successfully: $DB_NAME"